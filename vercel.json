{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/connexion.html",
      "dest": "/connexion.html"
    },
    {
      "src": "/inscription.html",
      "dest": "/inscription.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
